# ── General ─────────────────────────────────────────────
# URL pública principal (sin / al final)
BASE_URL=https://tudominio.com
# Dominio raíz para subdominios wildcard (sin https://). Si usas solo
# rutas /r/slug, déjalo vacío.
ROOT_DOMAIN=tudominio.com
# Secreto para firmar las sesiones del panel (genera uno: openssl rand -hex 32)
SESSION_SECRET=

# ── Base de datos (Neon) ────────────────────────────────
DATABASE_URL=postgres://usuario:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# ── Apple (certificados DE LA PLATAFORMA — los tuyos) ───
APPLE_TEAM_ID=
PASS_TYPE_ID=pass.com.tuplataforma.lealtad
APPLE_WWDR_B64=
APPLE_SIGNER_CERT_B64=
APPLE_SIGNER_KEY_B64=
APPLE_SIGNER_KEY_PASSPHRASE=

# ── Google (emisor DE LA PLATAFORMA) ────────────────────
GOOGLE_ISSUER_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY_B64=
